# Hikarich Finance — environment contract (Step 14 §15).
# Placeholders only. NEVER commit real values. Copy to .env.local for local work.
# Production and Preview values live in Vercel environment-scoped variables.

# development | preview | production
APP_ENV=development

# Canonical URL of THIS environment (no trailing slash).
APP_URL=http://localhost:3000

# Supabase project for THIS environment.
#  - development / preview  -> the NON-PRODUCTION project (or a local Supabase stack)
#  - production             -> the production project only
# The app refuses to start if a non-production APP_ENV points at the production project.
NEXT_PUBLIC_SUPABASE_URL=https://<non-production-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key-placeholder>

# Server-only privileged credential. Leave unset until a server operation needs it.
# It must NEVER be given a NEXT_PUBLIC_ name and must NEVER be scoped to Preview.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret salt (16+ random characters) for hashing the requester of a public payment claim.
# Optional in development and Preview; set a long random value in Production. Never commit a real value.
# PUBLIC_CLAIM_SALT=

# Resend (decision 279's open item, "Kirim Invoice via Email"). Optional: without both set, the email
# action reports "not configured" and the existing public-link share stays available. Never commit a real
# key. RESEND_FROM_EMAIL must be an address on a domain verified in the OWNER's Resend account.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Telegram bot (decision 422). Optional: without these the bot stays off. Never commit real values.
#  - TELEGRAM_BOT_TOKEN: from @BotFather.
#  - TELEGRAM_WEBHOOK_SECRET: any random 16-256 characters (letters, digits, _ or -); Telegram sends it back on every update.
#  - GEMINI_API_KEY: free key from Google AI Studio (https://aistudio.google.com/apikey). GEMINI_MODEL is optional
#    (default gemini-2.5-flash). The AI only reads the message or receipt photo; it never receives books data.
#  - CRON_SECRET: random 16+ characters; Vercel Cron sends it as "Authorization: Bearer <value>".
#  - SUPABASE_SERVICE_ROLE_KEY (above) is also needed: the bot calls its narrow service-role-only functions with it.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# CRON_SECRET=
